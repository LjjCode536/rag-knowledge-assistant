# 复制为 .env 后填写;.env 永不入库。
# 未填写 SILICONFLOW_API_KEY 时服务仍可启动,相关上游调用返回 UPSTREAM_NOT_CONFIGURED。

# ===== 运行环境 =====
ENVIRONMENT=local
LOG_LEVEL=INFO
# json: 生产/CI 用;console: 本地可读
LOG_FORMAT=console

# ===== 硅基流动(OpenAI 兼容)=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 模型(只出现在配置里,下线时改这里即可)=====
LLM_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 上游调用策略 =====
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
# 跨请求限速(T15,ADR-0013):相邻两次上游发送的最小间隔(秒),0 = 不限速;
# 免费档配额紧张时调大。上游 429 的 Retry-After 头优先于指数退避基数。
LLM_MIN_INTERVAL_SECONDS=0

# ===== 文档入库 =====
# 上传文件落盘目录(运行时产物,已被 gitignore,不入库)
UPLOAD_DIR=data/uploaded_docs
# 异步入库(M7·上,见 ADR-0012):true = 上传只登记与落盘立即返回任务句柄,
# 解析 / 切片 / 向量化转后台任务,进度经 GET /documents/{id} 的状态机可查;
# false = 请求内同步完成(与异步同一服务,行为一致;评估器 / 切分参数排查口径)
INGESTION_ASYNC=true

# ===== 文档切片(单次切片请求可覆盖,即时生效)=====
# paragraph:整体流切分基线;heading:按标题分节;table_aware:表格/代码原子;element:元素级
CHUNK_STRATEGY=table_aware
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 过短告警阈值(超过 CHUNK_SIZE 触发超长告警)
CHUNK_MIN_CHARS=20

# ===== 在线问答 =====
# 默认 top-k;低于阈值的检索命中不进入上下文,直接拒答
QA_TOP_K=3
QA_MIN_SCORE=0.35

# ===== 问答答档缓存(T15,ADR-0013)=====
# 相同问题(空白归一化 + 忽略大小写,连同 top_k / 阈值 / 过滤 / 生成器口径)在
# ttl 内直接复用上次答档:二次同题延迟显著下降,上游零消耗;文档向量化 /
# 退位 / 删除即刻清空缓存,答档不落后于知识库变化;命中率可由 /health 与日志查
QA_CACHE_ENABLED=true
QA_CACHE_TTL_SECONDS=300
QA_CACHE_MAXSIZE=128

# ===== 向量库后端(M3 三级存储:memory → chroma → pgvector)=====
# memory = 进程内存基线(默认,重启即失忆,测试 / CI 口径)
# chroma = Chroma 持久向量库(本地开发,数据落 data/chroma)
# pgvector = PostgreSQL 16 + pgvector 生产持久化(T13):
#   仓储(documents / chunks / query_logs / feedbacks)+ 向量库 + 评估留档
#   (evaluation_runs)全部落到 DATABASE_URL 指向的库(六张表)
# 先 docker compose up -d db 拉起本地库,再切 VECTOR_STORE=pgvector;
# 缺 DATABASE_URL 直接启动失败(配置期报错),绝不静默回退内存态。
VECTOR_STORE=memory
CHROMA_PATH=data/chroma

# ===== 生产持久化(pgvector 模式,T13)=====
# 与 docker-compose.yml 同一本地默认:rag / rag / rag
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag

# ===== 成本统计(T16,ADR-0014)=====
# Token 单价(元 / 千 Token),用于把查询日志里的 Token 用量折算成估算成本。
# 默认值按 Qwen/Qwen3-8B 量级给出占位值,换模型只改这里(估算口径,非账单)。
COST_PROMPT_PRICE_PER_1K=0.002
COST_COMPLETION_PRICE_PER_1K=0.006
COST_CURRENCY=CNY
# 统计分桶的默认粒度:hour / day(GET /api/v1/stats 的 bucket 参数默认值)
STATS_DEFAULT_BUCKET=day

# ===== 高级检索(教材第 43 章 RetrievalConfig:各能力逐项开关)=====
# 默认组合 = T07 消融最优且开销最小的 F/H 口径:重排 + 查询改写在
# GoldenSet 上把 Recall@3 / MRR 提到 1.0000,拒答正确率保持 1.0。
# 未入默认组合的能力依旧可查单测与消融数据(docs/iterations/0002-*):
# - 混合检索:单独开启会因融合归一分数破坏拒答阈值语义(B 组合),需搭配重排
# - MMR / 多查询扩展:边际收益为负或与本组合打平,按需开启
# 全关时检索时序与 T06 基线完全一致。
USE_QUERY_REWRITE=true
USE_MULTI_QUERY=false
USE_HYBRID=false
USE_MMR=false
USE_RERANK=true
# 融合权重:向量 / 关键词通道归一分加权(两者不可同时为 0)
RETRIEVAL_VECTOR_WEIGHT=0.7
RETRIEVAL_KEYWORD_WEIGHT=0.3
# 每条通道召回的候选池大小(重排 / MMR 需要远多于 top_k 的候选)
RETRIEVAL_CANDIDATE_K=30
# 多查询扩展变体数量(不含原查询)
RETRIEVAL_MULTI_QUERY_COUNT=3
# MMR 相关性 / 多样性权衡(1 = 纯相关性,0 = 纯多样性)
RETRIEVAL_MMR_LAMBDA=0.7
