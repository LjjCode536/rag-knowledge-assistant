# 复制为 .env 后填写;.env 永不入库。
# 未填写 SILICONFLOW_API_KEY 时服务仍可启动,相关上游调用返回 UPSTREAM_NOT_CONFIGURED。

# ===== 运行环境 =====
ENVIRONMENT=local
LOG_LEVEL=INFO
# json: 生产/CI 用;console: 本地可读
LOG_FORMAT=console

# ===== 硅基流动(OpenAI 兼容)=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 模型(只出现在配置里,下线时改这里即可)=====
LLM_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 上游调用策略 =====
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
